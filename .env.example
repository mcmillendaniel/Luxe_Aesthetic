# Absolute base URL of the deployed site, no trailing slash.
# Used at prerender time to build canonical, Open Graph, and sitemap URLs.
# Set this to the real production domain in Vercel's environment variables.
VITE_SITE_URL=https://example.com

# Set to "true" (or "1") to de-index the deploy: every prerendered route gets a
# noindex robots tag and the sitemap is emitted empty. Used by the shared demo
# host. Leave unset on client clones so they stay indexable.
# VITE_NOINDEX=true
